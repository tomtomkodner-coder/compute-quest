# ---------------------------------------------------------------
# Quiz Hack Lab — environment configuration
# Copy to .env (cp .env.example .env). Everything has safe defaults,
# so the project also runs without a .env file.
# ---------------------------------------------------------------

# ---- Mock Server (backend) ----
PORT=4000
HOST=0.0.0.0
# Comma separated list of origins allowed by CORS (the Vite dev server proxies
# /api and /ws, so this only matters if you call the backend directly).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A demo game is created on boot so AUTO JOIN works immediately.
DEMO_GAME=true
DEMO_PIN=123456
# Host token of the demo game (needed for Developer Mode controls).
DEMO_HOST_TOKEN=dev-host-token
# Restart the demo game automatically after it ends.
DEMO_LOOP=true
# Auto-start the demo game N ms after the first player joins.
DEMO_AUTOSTART_MS=3000

DEFAULT_TIME_LIMIT_MS=20000
# How long the "reveal" phase lasts between questions when auto-advance is on.
REVEAL_MS=4000
MAX_PLAYERS_PER_GAME=50
MAX_GAMES=100
# Players whose WebSocket dropped and did not come back are removed after this many ms (0 = never).
PLAYER_DISCONNECT_GRACE_MS=30000
# Server-side rate limit per IP (requests / minute). The client never tries to bypass it.
RATE_LIMIT_PER_MIN=1200

# ---- Frontend (Vite) ----
# Relative values go through the Vite dev proxy (recommended).
VITE_API_URL=/api
VITE_WS_URL=/ws
VITE_DEMO_PIN=123456
VITE_DEMO_HOST_TOKEN=dev-host-token
